# Copie para servidor.toml e substitua os IDs (Modo Desenvolvedor do Discord).
guild_id = "123456789012345678"

[modules]
administration = true
messaging = true
roles = true

[channels]
announcements = "123456789012345679"
moderation_logs = "123456789012345680"

[roles]
# Lista vazia permite qualquer usuário com a permissão Discord exigida.
# Quando preenchida, exige também um destes cargos (exceto dono do servidor).
moderators = ["123456789012345681"]

[messaging]
enabled = true
