# Copie para config/guilds/<name>/config.toml. Identidade fica em default.toml.
[modules]
messaging = true
rules = true
links = true
profile = true

[channels]
announcements = "111111111111111111"
rules = "222222222222222222"
links = "333333333333333333"

[channels.custom]
events = "444444444444444444"

[roles]
moderators = []
protected = [] # IDs de cargos que não podem ser alterados pelo bot.

[profile]
nickname = "Bot da Comunidade"
bio = "Bot oficial desta comunidade."
# Opcional: arquivo real dentro da pasta desta guilda; não é criado automaticamente.
# avatar = "assets/avatar.png"

# Opcional por guilda. Habilite apenas após preparar a Activity e verificar elegibilidade.
[activities.invite]
enabled = false
